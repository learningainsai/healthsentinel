# Copy to .env and fill in.
OPENAI_API_KEY=your-key-here

# Optional: LangSmith tracing (full traceability of every agent/tool call)
LANGSMITH_API_KEY=your-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=health-sentinel

# --- Multi-LLM cost-optimization routing --------------------------------
# Cheap/fast model: vision (meal photo recognition) + simple field extraction
HEALTHSENTINEL_CHEAP_MODEL=gpt-4o-mini
# Mid-tier model: nutrition cross-checks, activity/finance/calendar agents, recommendations
HEALTHSENTINEL_MID_MODEL=gpt-4o-mini
# Reasoning model: prediction engine + critic/guardrail review (highest stakes, lowest volume)
HEALTHSENTINEL_REASONING_MODEL=gpt-4o
# Embedding model for the medical-document RAG store
HEALTHSENTINEL_EMBEDDING_MODEL=text-embedding-3-small

# Optional: override the Chroma persistence directory
HEALTHSENTINEL_CHROMA_DIR=./data/chroma
